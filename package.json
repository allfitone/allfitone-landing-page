{
  "name": "allfitone-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "sync:brand": "allfitone-brand-assets ./public/brand/reusable",
    "check:brand": "npm run sync:brand && git diff --exit-code -- public/brand/reusable",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "ambassador:new": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ambassadors/new.mts",
    "ambassador:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ambassadors/check.mts"
  },
  "dependencies": {
    "@allfitone/react": "0.14.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@allfitone/brand": "0.4.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
