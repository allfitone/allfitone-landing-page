import { readdirSync, readFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

export const rootDir = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../..");
export const dataDir = path.join(rootDir, "src", "data", "ambassadors");
export const publicDir = path.join(rootDir, "public");
export const indexFile = path.join(dataDir, "index.ts");

/** Below this width a portrait looks soft on large screens; it is a warning, not an error. */
export const recommendedPhotoWidth = 1200;

export type ImageInfo = { format: "jpeg" | "png" | "webp"; width: number; height: number };

export const formatExtensions: Record<ImageInfo["format"], string> = { jpeg: "jpg", png: "png", webp: "webp" };

export function profileFiles() {
  return readdirSync(dataDir)
    .filter((file) => file.endsWith(".json"))
    .sort();
}

/** Maps a `/ambassadors/...` URL path to its file in `public/`. */
export function publicFile(src: string) {
  return path.join(publicDir, ...src.split("/").filter(Boolean));
}

/** Reads a JPEG's EXIF orientation; values 5 to 8 mean browsers display it rotated a quarter turn. */
function jpegOrientation(buffer: Buffer, start: number, end: number) {
  if (buffer.toString("ascii", start, start + 6) !== "Exif\0\0") return 1;
  const tiff = start + 6;
  const little = buffer.toString("ascii", tiff, tiff + 2) === "II";
  const read16 = (offset: number) => (little ? buffer.readUInt16LE(offset) : buffer.readUInt16BE(offset));
  const read32 = (offset: number) => (little ? buffer.readUInt32LE(offset) : buffer.readUInt32BE(offset));
  const directory = tiff + read32(tiff + 4);
  if (directory + 2 > end) return 1;
  for (let entry = 0; entry < read16(directory); entry += 1) {
    const offset = directory + 2 + entry * 12;
    if (offset + 12 > end) break;
    if (read16(offset) === 0x0112) return read16(offset + 8);
  }
  return 1;
}

/**
 * Reads the format and displayed pixel size of a JPEG, PNG, or WebP file from its header,
 * so the scripts need no image library. Rotated JPEGs report their displayed size.
 */
export function readImageInfo(file: string): ImageInfo | null {
  const buffer = readFileSync(file);

  if (buffer.length > 24 && buffer.readUInt32BE(0) === 0x89504e47) {
    return { format: "png", width: buffer.readUInt32BE(16), height: buffer.readUInt32BE(20) };
  }

  if (buffer.length > 30 && buffer.toString("ascii", 0, 4) === "RIFF" && buffer.toString("ascii", 8, 12) === "WEBP") {
    const chunk = buffer.toString("ascii", 12, 16);
    if (chunk === "VP8X") return { format: "webp", width: 1 + buffer.readUIntLE(24, 3), height: 1 + buffer.readUIntLE(27, 3) };
    if (chunk === "VP8 ") return { format: "webp", width: buffer.readUInt16LE(26) & 0x3fff, height: buffer.readUInt16LE(28) & 0x3fff };
    if (chunk === "VP8L") {
      const bits = buffer.readUInt32LE(21);
      return { format: "webp", width: (bits & 0x3fff) + 1, height: ((bits >> 14) & 0x3fff) + 1 };
    }
    return null;
  }

  if (buffer[0] === 0xff && buffer[1] === 0xd8) {
    let orientation = 1;
    let offset = 2;
    while (offset + 9 < buffer.length) {
      if (buffer[offset] !== 0xff) return null;
      const marker = buffer[offset + 1];
      if (marker === 0xff) {
        offset += 1;
        continue;
      }
      const length = buffer.readUInt16BE(offset + 2);
      if (marker === 0xe1) orientation = jpegOrientation(buffer, offset + 4, offset + 2 + length);
      // Start-of-frame markers carry the size; C4, C8, and CC share the range but do not.
      if (marker >= 0xc0 && marker <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marker)) {
        const height = buffer.readUInt16BE(offset + 5);
        const width = buffer.readUInt16BE(offset + 7);
        return orientation >= 5 ? { format: "jpeg", width: height, height: width } : { format: "jpeg", width, height };
      }
      offset += 2 + length;
    }
  }

  return null;
}

function importName(file: string) {
  const name = file.replace(/\.json$/, "").replace(/-([a-z0-9])/g, (_, next: string) => next.toUpperCase());
  return /^\d/.test(name) ? `ambassador${name}Profile` : `${name}Profile`;
}

/** The registry index imports every profile file; the site cannot discover them at runtime. */
export function renderIndex(files: string[]) {
  return [
    "// Generated by scripts/ambassadors. Run `npm run ambassador:check -- --write` instead of editing by hand.",
    ...files.map((file) => `import ${importName(file)} from "./${file}";`),
    "",
    "export const ambassadorSources: { file: string; data: unknown }[] = [",
    ...files.map((file) => `  { file: "${file}", data: ${importName(file)} },`),
    "];",
    "",
  ].join("\n");
}

export function readIndex() {
  return readFileSync(indexFile, "utf8").replace(/\r\n/g, "\n");
}

export function formatList(title: string, items: string[]) {
  return items.length === 0 ? "" : `${title}\n${items.map((item) => `  - ${item}`).join("\n")}\n`;
}
